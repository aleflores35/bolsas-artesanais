rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin: pode ver e gerenciar todas as contas.
    // IMPORTANTE: exige e-mail verificado — entre com o Google.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['alessandro.flores16@gmail.com']
        && request.auth.token.email_verified == true;
    }

    // Perfil do usuário (e-mail/nome) — o admin pode listar as contas
    match /users/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Dados do usuário: só o dono ou o admin
    match /users/{uid}/{colecao}/{doc=**} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Vitrine da loja: leitura pública; escrita só do dono dos produtos (ou admin)
    match /vitrine/{docId} {
      allow read: if true;
      allow create: if request.auth != null && (request.resource.data.uid == request.auth.uid || isAdmin());
      // update/delete exigem ser o DONO ATUAL do doc (corrige sobrescrever vitrine alheia) e não permitem trocar o dono
      allow update: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin())
        && request.resource.data.uid == resource.data.uid;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Bloqueia todo o resto (inclui as coleções antigas da raiz — só aplique
    // estas regras DEPOIS de fazer login no app e confirmar a migração!)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
